# Секреты Edge Functions. Локально: скопируйте в supabase/functions/.env
# (файл в .gitignore), в облаке: `supabase secrets set --env-file supabase/functions/.env`.

# Токен бота от @BotFather — им проверяется подпись initData и отправляются сообщения.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Произвольная строка (1–256 символов A-Za-z0-9_-), которой Telegram подписывает вызовы вебхука.
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-random-string
# Публичный HTTPS-адрес мини-приложения (GitHub Pages и т. п.).
WEB_APP_URL=https://example.github.io/zapisozhki/
